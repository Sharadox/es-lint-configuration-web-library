{
  "name": "@sharadox/es-lint-configuration-web-library",
  "version": "0.1.2",
  "description": "Shared ESLint flat configurations for Sharadox projects: Node, React libraries and Next.js applications, all Prettier-compatible.",
  "private": false,
  "license": "SEE LICENSE IN LICENCA.md",
  "author": "Sharadox <contact@sharadox.com>",
  "type": "module",
  "exports": {
    "./*/type": {
      "sharadox-source": "./source/*/type.ts",
      "types": "./distribution/*/type.d.ts"
    },
    "./*": {
      "sharadox-source": [
        "./source/*/index.ts",
        "./source/*/index.tsx"
      ],
      "types": "./distribution/*/index.d.ts",
      "default": "./distribution/*/index.js"
    }
  },
  "files": [
    "distribution",
    "LICENCA.md",
    "LICENSE.md",
    "NOTICE.md",
    "llms.txt"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@10.34.9",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "rm -rf distribution && tsc -p tsconfig.build.json",
    "lint": "NODE_OPTIONS=--conditions=sharadox-source eslint --max-warnings=0 .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "type-check": "tsc --noEmit",
    "test:unit": "vitest run --coverage",
    "documentation": "typedoc",
    "verify": "turbo run format:check lint type-check test:unit build",
    "prepare": "husky || true"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,cjs}": [
      "prettier --write",
      "eslint --fix --max-warnings=0"
    ],
    "*.{json,md,yml,yaml,scss}": "prettier --write"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Sharadox/es-lint-configuration-web-library.git"
  },
  "homepage": "https://github.com/Sharadox/es-lint-configuration-web-library#readme",
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@vitest/coverage-v8": "^5.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.5",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "next": "16.4.5",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "turbo": "^2.11.10",
    "typedoc": "^0.28.20",
    "typescript": "6.0.3",
    "vitest": "^5.1.0"
  },
  "dependencies": {
    "eslint-plugin-react-hooks": "^7.1.1",
    "@eslint/js": "^9.39.5",
    "typescript-eslint": "^8.72.2",
    "eslint-config-prettier": "^10.1.8"
  },
  "peerDependencies": {
    "eslint": ">=9",
    "typescript": ">=5",
    "eslint-config-next": ">=16"
  },
  "peerDependenciesMeta": {
    "eslint-config-next": {
      "optional": true
    }
  }
}
